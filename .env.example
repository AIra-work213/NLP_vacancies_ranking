# Только для локальной разработки; замените примерные учётные данные перед публикацией
NLP_RANKER_ENVIRONMENT=local
NLP_RANKER_LOG_LEVEL=INFO
NLP_RANKER_LOG_FORMAT=console

NLP_RANKER_MLFLOW_TRACKING_URI=http://localhost:5000
NLP_RANKER_MLFLOW_EXPERIMENT=nlp-ranker

NLP_RANKER_POSTGRES_DSN=postgresql+asyncpg://nlp_ranker:local-dev-only@localhost:5432/nlp_ranker

NLP_RANKER_REDIS_URL=redis://localhost:6379/0
NLP_RANKER_REDIS_MAX_CONNECTIONS=10
NLP_RANKER_CACHE_TTL_SECONDS=300

NLP_RANKER_API_URL=http://localhost:8000

NLP_RANKER_S3_ENDPOINT_URL=http://localhost:9000
NLP_RANKER_S3_BUCKET=nlp-ranker
NLP_RANKER_S3_CONCURRENCY=2

POSTGRES_PASSWORD=local-dev-only

MINIO_ROOT_USER=nlp_ranker
MINIO_ROOT_PASSWORD=local-dev-only

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-dev-only
# Учётные данные S3 для DVC: локально совпадают с данными MinIO
AWS_ACCESS_KEY_ID=nlp_ranker
AWS_SECRET_ACCESS_KEY=local-dev-only
AWS_DEFAULT_REGION=us-east-1

NLP_RANKER_SEARCH_ENABLED=true
NLP_RANKER_SEARCH_CONFIG_PATH=configs/search.yaml
NLP_RANKER_SEARCH_ACTIVE_LIMIT=1
NLP_RANKER_SEARCH_WAITING_LIMIT=8
NLP_RANKER_SEARCH_QUEUE_TIMEOUT_SECONDS=1
NLP_RANKER_SEARCH_TIMEOUT_SECONDS=10

NLP_RANKER_CACHE_ENABLED=true
NLP_RANKER_CACHE_TIMEOUT_SECONDS=0.1
NLP_RANKER_CACHE_MAX_BYTES=65536
